{
  "ConnectorAgent": {
    // Matches the API's launch profile, so `dotnet run` in both project
    // directories is a complete local system.
    "ControlPlaneBaseUrl": "http://localhost:8410/",
    "AgentName": "local-bank-agent",

    // The one step that cannot be pre-configured: an enrollment code is
    // single-use and minted by the running control plane. Mint one with
    //   POST /v1/agents/enrollment { "subject": "u_local", "name": "local-bank-agent" }
    // and paste it here, or pass ConnectorAgent__EnrollmentCode. After the
    // first successful enrollment the state file below carries the identity
    // and this value is ignored.
    "EnrollmentCode": "",

    // Never "residential" locally. Claiming it would let a job that genuinely
    // needs a residential line be routed to a laptop on hotel wifi.
    "Egress": { "Country": "NL", "Kind": "any" },

    // Unique per agent INSTANCE, which is why they are named and not left to
    // the per-user defaults: the bank and shopping agents on one developer's
    // machine would otherwise share an enrollment and sweep each other's
    // scratch directories out from under running jobs. Under artifacts/
    // because the repo already ignores that name at any depth - the state
    // file holds a live agent token and must never be committed.
    "StateFilePath": "artifacts/agent-state.json",
    "ProfileRootDirectory": "artifacts/profiles",
    "WorkRootDirectory": "artifacts/work"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Connector.Kit.Agent": "Debug"
    }
  }
}
