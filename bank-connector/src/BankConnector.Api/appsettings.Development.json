{
  // A clean-machine `dotnet run`: Sqlite in the project directory, no PKI, no
  // OIDC authority, and a bundle key ring minted in memory at startup.
  //
  // Connector:Bundle is deliberately absent. With no keys configured the
  // platform mints an ephemeral ring, so a restart invalidates every bundle
  // ever issued - which is the correct local behaviour and an unacceptable
  // deployed one, hence the production refusal in appsettings.json.
  //
  // Connector:Auth:SharedSecret is absent too, which leaves the API open on
  // localhost. Set it to any string to require that value in X-Connector-Key.
  "Connector": {
    "Mode": "Development",
    "Database": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=bank-connector.dev.db"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
