{
  // Production-shaped by default, on purpose. A container that starts with no
  // configuration at all must refuse to boot rather than come up holding
  // people's credentials under a key that dies with the process;
  // appsettings.Development.json is what relaxes this for a local run.
  //
  // ConnectionString, Auth, Bundle and EnrollmentHmacKey are absent because
  // they are secrets: they come from the environment as
  // Connector__Database__ConnectionString, Connector__Bundle__Keys__k1 and so
  // on. A secret in an appsettings file is a secret in the image.
  "Connector": {
    "Mode": "Production",
    "Database": {
      "Provider": "Postgres"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
