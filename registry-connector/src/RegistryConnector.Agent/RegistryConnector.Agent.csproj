<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The registry product's data plane. A shell over Connector.Kit.Agent: the
    lease loop, the browser harness and the challenge relay all live there.

    It exists because a registry agent must carry the REGISTRY adapters. The
    first version of this stack pointed registry-agent at the shopping image,
    which enrolled happily and then advertised fifteen shop providers and no
    BKR - an agent that can never be given the one job it was started for.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RegistryConnector.Agent</RootNamespace>
    <AssemblyName>RegistryConnector.Agent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" DependentUpon="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\connector-kit\src\Connector.Kit.Agent\Connector.Kit.Agent.csproj" />
    <ProjectReference Include="..\RegistryConnector.Adapters\RegistryConnector.Adapters.csproj" />
  </ItemGroup>

</Project>
