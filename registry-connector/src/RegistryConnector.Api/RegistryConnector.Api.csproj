<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The registry product's control plane. A shell, deliberately: everything a
    control plane does lives in Connector.Kit.Hosting, so a behaviour cannot
    exist here and be silently missing from the other two connectors.
  -->
  <PropertyGroup>
    <RootNamespace>RegistryConnector.Api</RootNamespace>
    <AssemblyName>RegistryConnector.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\connector-kit\src\Connector.Kit.Hosting\Connector.Kit.Hosting.csproj" />
    <ProjectReference Include="..\RegistryConnector.Adapters\RegistryConnector.Adapters.csproj" />
  </ItemGroup>

</Project>
