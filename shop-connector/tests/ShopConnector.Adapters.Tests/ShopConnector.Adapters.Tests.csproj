<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The offline parse suite.

    Adapter maintenance is the ongoing cost of the shopping connector, so
    this is the suite that has to catch a provider changing shape before a
    user does. Nothing here opens a socket or starts a browser: every test
    runs against a recorded fixture, a stubbed HttpMessageHandler, or the
    IJumboGraphQlClient seam.
  -->
  <PropertyGroup>
    <RootNamespace>ShopConnector.Adapters.Tests</RootNamespace>
    <!-- Must match the InternalsVisibleTo in ShopConnector.Adapters.csproj:
         the parsers are internal, and a parse test that has to build an HTTP
         stub to check a discount sign is a test nobody writes. -->
    <AssemblyName>ShopConnector.Adapters.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShopConnector.Adapters\ShopConnector.Adapters.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
