{
  // The relay's base configuration. BaseUrl and SubjectSalt are deliberately
  // empty here: a deployment must supply both, and the relay refuses to start
  // without them rather than fall back to a shared salt that would let the two
  // connectors correlate the same person.
  "Relay": {
    "Connectors": {
      "shop": {
        "Name": "Shopping",
        "Kind": "store",
        "Order": 1,
        "BaseUrl": "",
        "SubjectSalt": "",
        "TimeoutSeconds": 45
      },
      "bank": {
        "Name": "Banking",
        "Kind": "bank",
        "Order": 2,
        "BaseUrl": "",
        "SubjectSalt": "",
        "TimeoutSeconds": 45
      },
      "registry": {
        "Name": "Registries",
        "Kind": "registry",
        "Order": 3,
        "BaseUrl": "",
        "SubjectSalt": "",
        "TimeoutSeconds": 45
      }
    }
  },

  "Demo": {
    "UserId": "demo-user",
    "CredentialsFile": "credentials.local.jsonc"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "AllowedHosts": "*"
}
